  "Changes": [
    "\u4FEE\u590D Windows 11 \u5FAE\u8F6F\u62FC\u97F3\u786E\u8BA4\u4E2D\u6587\u6587\u672C\u65F6\u7F16\u8F91\u5668\u53EF\u80FD\u95EA\u5C4F\u7684\u95EE\u9898\u3002",
    "\u8F93\u5165\u6CD5\u5019\u9009\u7A97\u4E0E\u7EC4\u5408\u7A97\u4EC5\u5728\u7EC4\u5408\u5F00\u59CB\u6216\u63D2\u5165\u70B9\u5B9E\u9645\u53D8\u5316\u65F6\u91CD\u65B0\u5B9A\u4F4D\uFF0C\u907F\u514D TSF/IMM \u901A\u77E5\u5FAA\u73AF\u3002",
    "\u4EC5\u5305\u542B\u63D0\u4EA4\u7ED3\u679C\u7684\u8F93\u5165\u6CD5\u6D88\u606F\u4F1A\u7ACB\u5373\u7ED3\u675F\u9884\u7F16\u8F91\u72B6\u6001\uFF0C\u4E0D\u518D\u77ED\u6682\u91CD\u65B0\u6FC0\u6D3B\u7A7A\u7EC4\u5408\u6587\u672C\u3002",
    "\u8BCA\u65AD\u5305\u65B0\u589E\u8F93\u5165\u6CD5\u6D3B\u52A8\u3001\u7EC4\u5408\u5F00\u59CB\u4E0E\u7ED3\u675F\u3001\u63D0\u4EA4\u5E27\u548C\u6700\u5927\u9884\u7F16\u8F91\u957F\u5EA6\u8BA1\u6570\uFF0C\u4FBF\u4E8E\u6392\u67E5\u4E0D\u540C\u8BA1\u7B97\u673A\u4E0A\u7684\u8F93\u5165\u95EE\u9898\u3002"
  ],
  "CompatibilityNotes": [
    "\u8F93\u5165\u6CD5\u8BCA\u65AD\u4EC5\u8BB0\u5F55\u4E8B\u4EF6\u6570\u91CF\u548C\u6587\u672C\u957F\u5EA6\uFF0C\u4E0D\u8BB0\u5F55\u7528\u6237\u5B9E\u9645\u8F93\u5165\u5185\u5BB9\u3002",
    "\u82F1\u6587\u952E\u76D8\u8F93\u5165\u548C\u73B0\u6709\u5FEB\u6377\u952E\u884C\u4E3A\u4FDD\u6301\u4E0D\u53D8\u3002"
  ],
