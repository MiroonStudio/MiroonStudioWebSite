  "Summary": "\u8D44\u6E90\u7BA1\u7406\u5668\u4E0E\u8BCA\u65AD\u5BFC\u51FA\u4F53\u9A8C\u4FEE\u590D",
  "Changes": [
    "\u8D44\u6E90\u7BA1\u7406\u5668\u6539\u7528\u53F3\u952E\u83DC\u5355\u63D0\u4F9B\u65B0\u5EFA LaTeX \u6587\u4EF6\u3001\u65B0\u5EFA\u5B50\u6587\u4EF6\u5939\u3001\u91CD\u547D\u540D\u3001\u79FB\u81F3\u56DE\u6536\u7AD9\u548C\u5237\u65B0\u64CD\u4F5C\u3002",
    "\u4FEE\u590D\u4ECE\u4E3B\u9875\u5207\u56DE\u5DE5\u4F5C\u53F0\u540E\u8D44\u6E90\u7BA1\u7406\u5668\u53EF\u80FD\u4FDD\u6301\u9690\u85CF\uFF0C\u4EE5\u53CA\u6D3B\u52A8\u680F\u72B6\u6001\u4E0E\u5B9E\u9645\u7A97\u683C\u4E0D\u4E00\u81F4\u7684\u95EE\u9898\u3002",
    "\u8BCA\u65AD\u5305\u7EE7\u7EED\u7531\u7528\u6237\u81EA\u884C\u9009\u62E9\u4FDD\u5B58\u4F4D\u7F6E\uFF1B\u5BFC\u51FA\u5B8C\u6210\u63D0\u793A\u73B0\u5728\u6309\u5B9E\u9645\u5B57\u5BBD\u6362\u884C\uFF0C\u957F\u8DEF\u5F84\u4E0D\u518D\u91CD\u53E0\u9519\u4F4D\u3002",
    "\u4FEE\u590D\u53F3\u952E\u5220\u9664\u6700\u540E\u4E00\u4E2A\u5DF2\u6253\u5F00\u6587\u4EF6\u65F6\u5076\u5C14\u9519\u8BEF\u8FD4\u56DE\u4E3B\u9875\u7684\u95EE\u9898\u3002"
  ],
  "CompatibilityNotes": [
    "\u5220\u9664\u64CD\u4F5C\u4ECD\u4F1A\u5C06\u6587\u4EF6\u79FB\u5165 Windows \u56DE\u6536\u7AD9\uFF0C\u4E0D\u4F1A\u6C38\u4E45\u5220\u9664\u3002",
    "\u8BCA\u65AD\u5305\u4EC5\u4FDD\u5B58\u5728\u7528\u6237\u9009\u62E9\u7684\u4F4D\u7F6E\uFF0C\u4E0D\u4F1A\u81EA\u52A8\u4E0A\u4F20\u3002"
  ],
